import pyxel
import random

altura = 256
largura = 240
nave = 16
xpObjetivo = 5000
spriteAlien = (16,0)
spritePirata = (32,0)
spriteUFO = (48,0)


#Classe para o fundo estrelado:
class Fundo:
    def __init__(self):
        self.x = random.randint(0, largura)
        self.y = random.randint(0, altura)
        self.velocidade = random.choice([0.3, 0.3, 0.4])
        self.tamanho = random.choice([1,1,1,2])
        
    def update(self):
        self.y += self.velocidade
        if self.y >= altura:
            self.y = 0
            self.x = random.randint(0, largura - 1) #move a estrela para um x aleatoria quando ela alcança o fim da janela.
        
    def draw(self):
        pyxel.rect(int(self.x),int(self.y),self.tamanho,self.tamanho,7) # como as estrelas são quadrados, altura == largura

#Classe responsável pela nave do player
class Player:
    def __init__(self):
        self.x = largura // 2 # bota a nave no meio da janela capish
        self.y = altura - 50
        self.velocidade = 2.5

        #animação fogo da nave
        self.time_animacao = 0
        self.frame_animacao = 0

        #escudo
        self.escudoTempo = 0
        self.duracaoEscudo = 300

        self.vidaMaxima = 100
        self.vida = self.vidaMaxima

    def update(self):
        #movimentação
        if pyxel.btn(pyxel.KEY_LEFT) or pyxel.btn(pyxel.KEY_A):
            self.x -= self.velocidade
        if pyxel.btn(pyxel.KEY_RIGHT) or pyxel.btn(pyxel.KEY_D):
            self.x += self.velocidade

        if pyxel.btn(pyxel.KEY_UP) or pyxel.btn(pyxel.KEY_W):
            self.y -= self.velocidade
        if pyxel.btn(pyxel.KEY_DOWN) or pyxel.btn(pyxel.KEY_S):
            self.y += self.velocidade

        # Impede sair da tela
        if self.x < nave // 2:
            self.x = nave // 2
        if self.x > largura - nave // 2:
            self.x = largura - nave // 2
        if self.y < nave // 2:
            self.y = nave // 2
        if self.y > altura - nave // 2:
            self.y = altura - nave // 2
        

        #animação fogo da nave
        self.time_animacao += 1
        if self.time_animacao >= 30:
            self.time_animacao = 0
            if self.frame_animacao == 0:
                self.frame_animacao = 1
            else:
                self.frame_animacao = 0

        # Tempo de duração do escudo
        if self.escudoTempo > 0:
            self.escudoTempo -= 1

    def draw(self):
        if self.frame_animacao == 0:
            pyxel.blt(self.x - nave // 2, self.y - nave // 2, 0, 0, 0, nave, nave, 0)
        else:
            pyxel.blt(self.x - nave // 2, self.y - nave // 2, 0, 0, 16, nave, nave, 0)

        # Desenha o escudo
        if self.escudoTempo > 0:
            pyxel.blt(self.x - nave // 2, self.y - nave // 2, 0, 0, 96, nave, nave, 0)

class Disparos:
    def __init__(self, x, y, velocidade, direcao):
        self.x = x
        self.y = y
        self.velocidade = velocidade
        self.direcao = direcao

    def update(self):
        self.y += self.velocidade * self.direcao

    def draw(self):
        pyxel.rect(self.x, self.y, 2, 5, 10)

class Inimigo:
    def __init__(self,x,y,tipo):
        self.x = x
        self.y = y
        self.tipo = tipo
        self.ativo = True

        if tipo == 1:
            self.vida = 1
            self.velocidade = 0.5
            self.velocidadeTiro = 1.5
            self.danoTiro = 10
            self.xp = 50
            self.sprite = spriteAlien

        elif tipo == 2:
            self.vida = 2
            self.velocidade = 0.7
            self.velocidadeTiro = 2.0
            self.danoTiro = 20
            self.xp = 100
            self.sprite = spritePirata

        elif tipo == 3:
            self.vida = 4
            self.velocidade = 1.0
            self.velocidadeTiro = 2.5
            self.danoTiro = 30
            self.xp = 150
            self.sprite = spriteUFO

        self.tempoTiro = 0
        self.intervaloTiro = random.randint(60, 120)

    def update(self):
        self.y += self.velocidade
        if self.y > altura + nave:

            self.ativo = False

    def podeAtirar(self):
        self.tempoTiro += 1

        if self.tempoTiro >= self.intervaloTiro:
            self.tempoTiro = 0
            self.intervaloTiro = random.randint(60, 120)
            return True
        return False

    def draw(self):
        if not self.ativo:
            return

        sprite_x, sprite_y = self.sprite

        pyxel.blt(self.x - nave // 2, self.y - nave // 2, 0, sprite_x, sprite_y, nave, nave, 0)

class PowerUp:
    def __init__(self, x, y, tipo="vida"):
        self.x = x
        self.y = y
        self.tipo = tipo
        self.velocidade = 0.7
        self.ativo = True

    def update(self):
        self.y += self.velocidade

        if self.y > altura:
            self.ativo = False

    def draw(self):
        if not self.ativo:
            return

        if self.tipo == "vida":
            sprite_x, sprite_y = 24, 88
        elif self.tipo == "escudo":
            sprite_x, sprite_y = 16, 80

        pyxel.blt(int(self.x - 4), int(self.y - 4), 0, sprite_x, sprite_y, 8, 8, 0)

class Jogo:
    def __init__(self):
        pyxel.init(largura, altura, title = 'SpaceRaiders')

        #jogador
        self.player = Player()
        self.xp = 0

        # Configurações do superaquecimento dos canhões
        self.calorCanhoes = 0
        self.calorMaximo = 100
        self.calorPorDisparo = 2.5
        self.resfriamentoPorQuadro = 0.6
        self.tempoSemDisparo = 0
        self.tempoInicioResfriamento = 15
        self.duracaoSuperaquecimento = 150
        self.tempoSuperaquecimento = 0

        #estados
        self.menuInicial = True
        self.gameOver = False
    
        #banco de imagens - sprites
        pyxel.load("Sprites/meu_jogo.pyxres")

        #fundo
        self.estrelas = []
        for i in range(70):
            self.estrelas.append(Fundo())

        #Power Ups
        self.powerUps = []

        #disparos
        self.disparos = []
        self.tempo_tiro = 0

        #disparos dso inimigos
        self.disparosInimigos = []

        #inimigos
        self.inimigos = []
        self.timerSpawn = 0
        self.tempoSpawn = 22
        self.spawnFinalizado = False

        #explosões
        self.explosoes = []


        pyxel.run(self.update, self.draw)

    def reiniciarJogo(self):
        #reiniciar variáveis
        self.player = Player()
        self.xp = 0
        self.calorCanhoes = 0
        self.tempoSemDisparo = 0
        self.tempoSuperaquecimento = 0
        self.gameOver = False

        self.disparos = []
        self.tempo_tiro = 0
        self.disparosInimigos = []

        self.powerUps = []

        self.inimigos = []
        self.timerSpawn = 0
        self.tempoSpawn = 22
        self.spawnFinalizado = False

        self.explosoes = []

    def update(self):
        if self.menuInicial:
            if pyxel.btnp(pyxel.KEY_RETURN):
                self.menuInicial = False
            return

        if self.gameOver:
            for explosao in self.explosoes[:]:
                explosao.update()
                if not explosao.ativa:
                    self.explosoes.remove(explosao)
            if pyxel.btnp(pyxel.KEY_RETURN):
                self.reiniciarJogo()
            return
        
        #fundo
        for estrela in self.estrelas:
            estrela.update()

        self.verificarFase()

        #atualiza as explosões
        for explosao in self.explosoes[:]:
            explosao.update()
            if not explosao.ativa:
                self.explosoes.remove(explosao)

        if not self.spawnFinalizado:
            self.timerSpawn += 1
            if self.timerSpawn >= self.tempoSpawn:
                self.timerSpawn = 0
                self.criarInimigo()

        for inimigo in self.inimigos:
            inimigo.update()

            if inimigo.ativo and inimigo.podeAtirar():
                tiro = Disparos(
                    inimigo.x - 1,
                    inimigo.y + 8,
                    inimigo.velocidadeTiro,
                    1
                )

                tiro.dano = inimigo.danoTiro
                self.disparosInimigos.append(tiro)
        
        self.player.update()


        # Controla o tempo de superaquecimento
        if self.tempoSuperaquecimento > 0:
            self.tempoSuperaquecimento -= 1

            if self.tempoSuperaquecimento == 0:
                self.calorCanhoes = 0
                self.tempoSemDisparo = 0

        # Verifica se ocorreu um disparo neste quadro
        disparou = False

        # Dispara somente se os canhões não estiverem superaquecidos
        if pyxel.btn(pyxel.KEY_SPACE) and self.tempo_tiro == 0 and self.tempoSuperaquecimento <= 0:
            tiro = Disparos(self.player.x - 1, self.player.y - 13, 4, -1)
            self.disparos.append(tiro)
            self.tempo_tiro = 5
            disparou = True

            # Aumenta o calor a cada disparo
            self.calorCanhoes += self.calorPorDisparo

            if self.calorCanhoes >= self.calorMaximo:
                self.calorCanhoes = self.calorMaximo
                self.tempoSuperaquecimento = self.duracaoSuperaquecimento

        # Diminui a espera entre os disparos
        if self.tempo_tiro > 0:
            self.tempo_tiro -= 1

        # Controla o resfriamento dos canhões
        if disparou:
            self.tempoSemDisparo = 0
        elif self.tempoSuperaquecimento <= 0:
            self.tempoSemDisparo += 1

            if self.tempoSemDisparo >= self.tempoInicioResfriamento:
                self.calorCanhoes = max(0, self.calorCanhoes - self.resfriamentoPorQuadro)

        # Movimenta os tiros e remove os que saíram da tela
        
        # Movimenta os tiros
        for tiro in self.disparos[:]:

            tiro.update()

            # Remove o tiro quando sai da tela
            if tiro.y + 5 < 0:

                self.disparos.remove(tiro)
                continue

            # Verifica se o tiro acertou algum inimigo
            for inimigo in self.inimigos:

                if inimigo.ativo:

                    if (tiro.x < inimigo.x + 8 and tiro.x + 2 > inimigo.x - 8 and tiro.y < inimigo.y + 8 and tiro.y + 5 > inimigo.y - 8):

                        inimigo.vida -= 1
                        self.disparos.remove(tiro)

                        if inimigo.vida <= 0:

                            inimigo.ativo = False
                            self.xp += inimigo.xp

                            explosao = Explosao(inimigo.x, inimigo.y)
                            self.explosoes.append(explosao)

                            chanceDrop = random.random()

                            if chanceDrop < 0.10:
                                self.powerUps.append(PowerUp(inimigo.x, inimigo.y, "vida"))
                            elif chanceDrop < 0.15:
                                self.powerUps.append(PowerUp(inimigo.x, inimigo.y, "escudo"))
                            break

        # Atualiza os disparos inimigos
        for tiro in self.disparosInimigos[:]:
            tiro.update()

            if tiro.y > altura:
                self.disparosInimigos.remove(tiro)
                continue

            if tiro.x < self.player.x + 8 and tiro.x + 2 > self.player.x - 8 and tiro.y < self.player.y + 8 and tiro.y + 5 > self.player.y - 8:
                if self.player.escudoTempo <= 0:
                    self.receberDano(tiro.dano)
                self.disparosInimigos.remove(tiro)

        
        # Atualiza os power-ups e verifica a coleta
        for powerUp in self.powerUps[:]:
            powerUp.update()

            if not powerUp.ativo:
                self.powerUps.remove(powerUp)
                continue

            # Verifica colisão com o jogador
            if powerUp.x - 4 < self.player.x + 8 and powerUp.x + 4 > self.player.x - 8 and powerUp.y - 4 < self.player.y + 8 and powerUp.y + 4 > self.player.y - 8:
                if powerUp.tipo == "vida":
                    self.player.vida = min(self.player.vidaMaxima, self.player.vida + 35)
                elif powerUp.tipo == "escudo":
                    self.player.escudoTempo = self.player.duracaoEscudo

                self.powerUps.remove(powerUp)

        # Remove os inimigos destruídos ou que saíram da tela
        for inimigo in self.inimigos[:]:
            if not inimigo.ativo:
                self.inimigos.remove(inimigo)
                continue

            if (self.player.x - 8 < inimigo.x + 8 and
                self.player.x + 8 > inimigo.x - 8 and
                self.player.y - 8 < inimigo.y + 8 and
                self.player.y + 8 > inimigo.y - 8):

                self.receberDano(25)
    
    def criarInimigo(self):
        if self.spawnFinalizado:

            return
        x = random.randint(nave // 2, largura - nave // 2)
        y = -nave//2
        self.inimigos.append(Inimigo(x,y,self.fase))

    def verificarFase(self):
        if self.xp < 1000:
            self.fase = 1
        elif self.xp < 2500:
            self.fase = 2
        elif self.xp < xpObjetivo:
            self.fase = 3
        else: 
            self.spawnFinalizado = True

    def receberDano(self, dano):
        self.player.vida -= dano

        if self.player.vida <= 0:
            self.player.vida = 0
            self.explosoes.append(Explosao(self.player.x, self.player.y))
            self.gameOver = True

    def draw(self):
        pyxel.cls(0)

        # Menu
        if self.menuInicial:
            for fundo in self.estrelas:
                fundo.draw()
            pyxel.text(largura // 2 - 28, 90, "SPACE RAIDERS", 12)
            pyxel.text(largura // 2 - 30, 125, "PRESSIONE ENTER", 7)
            pyxel.text(10, altura - 10, "Samuel, Renan e Bernardo - FURG", 7)
            return

        for fundo in self.estrelas:
            fundo.draw()

        for inimigo in self.inimigos:
            inimigo.draw()

        for powerUp in self.powerUps:
            powerUp.draw()

        for explosao in self.explosoes:
            explosao.draw()

        if not self.gameOver:
            self.player.draw()

        for tiro in self.disparos:
            tiro.draw()

        for tiro in self.disparosInimigos:
            tiro.draw()

        # HUD - Barra de vida
        pyxel.text(8, altura - 25, "VIDA", 7)

        pyxel.rect(8, altura - 15, 60, 6, 8)

        larguraVida = int(60 * self.player.vida / self.player.vidaMaxima)

        if larguraVida > 0:
            pyxel.rect(8, altura - 15, larguraVida, 6, 11)

        # HUD - Barra de calor dos canhões
        pyxel.text(8, altura - 42, "CALOR", 7)
        pyxel.rect(8, altura - 32, 60, 5, 1)
        larguraCalor = int(60 * self.calorCanhoes / self.calorMaximo)
        corCalor = 9

        if self.tempoSuperaquecimento > 0:
            corCalor = 8

        if larguraCalor > 0:
            pyxel.rect(8, altura - 32, larguraCalor, 5, corCalor)

        # Mensagem de superaquecimento
        if self.tempoSuperaquecimento > 0 and not self.gameOver:
            pyxel.text(largura // 2 - 44, altura // 2 - 65, "ARMAS SUPERAQUECIDAS!", 8)
            pyxel.text(largura // 2 - 23, altura // 2 - 50, "AGUARDE...", 7)
        
        #tela de game over
        if self.gameOver:
            #pyxel.text(largura // 2, altura // 2 - 15, "I", 8) pra testar o alinhamento
            pyxel.text(largura // 2 - 17, altura // 2 - 10, "GAME OVER", 8)
            pyxel.text(largura // 2 - 12, altura // 2 + 5, "XP: " + str(self.xp), 7)
            pyxel.text(largura // 2 - 26, altura // 2 + 15, "PRESSIONE ENTER", 10)
            pyxel.text(largura // 2 - 35, altura // 2 + 25, "PARA JOGAR NOVAMENTE", 10)
            return

class Explosao:
    def __init__(self, x, y):
        self.x = x
        self.y = y

        # Coordenadas dos quadros da animação
        self.sprites = [
            (0, 32),
            (0, 48),
            (0, 64),
            (0, 80)
        ]

        self.quadro = 0
        self.tempo = 0
        self.velocidadeAnimacao = 5
        self.ativa = True

    def update(self):
        self.tempo += 1

        if self.tempo >= self.velocidadeAnimacao:
            self.tempo = 0
            self.quadro += 1

            if self.quadro >= len(self.sprites):
                self.ativa = False

    def draw(self):
        if not self.ativa:
            return

        sprite_x, sprite_y = self.sprites[self.quadro]

        pyxel.blt(
            self.x - nave // 2,
            self.y - nave // 2,
            0,
            sprite_x,
            sprite_y,
            nave,
            nave,
            0
        )

Jogo()